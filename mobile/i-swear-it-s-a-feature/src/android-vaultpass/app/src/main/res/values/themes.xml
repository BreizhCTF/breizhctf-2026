<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VaultPass" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/vault_primary</item>
        <item name="colorPrimaryVariant">@color/vault_primary</item>
        <item name="colorOnPrimary">@color/vault_text</item>
        <item name="colorSecondary">@color/vault_accent</item>
        <item name="colorSecondaryVariant">@color/vault_accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/vault_bg</item>
        <item name="colorSurface">@color/vault_surface</item>
        <item name="colorOnSurface">@color/vault_text</item>
        <item name="android:statusBarColor">@color/vault_bg</item>
        <item name="android:navigationBarColor">@color/vault_bg</item>
        <item name="android:windowBackground">@color/vault_bg</item>
    </style>

    <style name="VaultButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/vault_accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="VaultPasswordInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/vault_accent</item>
        <item name="hintTextColor">@color/vault_accent</item>
        <item name="android:textColorHint">@color/vault_text_muted</item>
    </style>

    <style name="VaultDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@color/vault_surface</item>
        <item name="android:textColor">@color/vault_text</item>
        <item name="colorAccent">@color/vault_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/VaultDialogButton</item>
    </style>

    <style name="VaultDialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/vault_accent</item>
    </style>
</resources>
