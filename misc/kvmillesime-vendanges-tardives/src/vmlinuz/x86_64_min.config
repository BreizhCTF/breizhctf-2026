# --- CORE (Identique) ---
CONFIG_INITRAMFS_SOURCE=""
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PRINTK=y
CONFIG_BUG=y

# --- X86 SPECIFIC (Le plus important) ---
CONFIG_64BIT=y                # Force le mode 64 bits (sinon allnoconfig peut tenter du 32 bits)
CONFIG_SMP=y                  # Support multi-coeur (recommandé même pour 1 CPU)
CONFIG_X86_64=y               # Architecture cible

# --- GENERAL SETUP (Identique) ---
CONFIG_POSIX_MQUEUE=y
CONFIG_MULTIUSER=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLOCK=y

# --- BUS & DRIVERS ---
CONFIG_PCI=y
# CONFIG_PCI_HOST_GENERIC est inutile sur x86, l'architecture le gère nativement

# --- VIRTIO (Identique) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y

# --- CONSOLE (CHANGEMENT CRITIQUE) ---
CONFIG_TTY=y
# Sur x86, la console série standard est la 8250 (UART)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
# Pour être sûr qu'il la trouve sur le bus (parfois nécessaire sur QEMU)
CONFIG_SERIAL_8250_PCI=y 
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# --- OPTIONAL ---
CONFIG_GDB_SCRIPTS=y
